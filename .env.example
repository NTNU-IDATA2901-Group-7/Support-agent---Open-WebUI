# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL=''

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false


# ===============================
# Added for support agent project
# ===============================

# For test environment
OPEN_WEBUI_API_KEY=<paste your JWT token here>

# Chat settings
DEFAULT_LOCALE=en # Can potentially swap to 'no' for norwegian
USER_PERMISSIONS_CHAT_MULTIPLE_MODELS=false # Do not allow user to use multiple models at the same time

# Azure OpenAI
DEFAULT_MODELS=gpt-4.1-mini
OPENAI_API_KEY=some_key
OPENAI_API_BASE_URL=https://solwr-ai-poc.cognitiveservices.azure.com/openai/deployments/gpt-4.1-mini

# RAG
RAG_EMBEDDING_ENGINE=azure_openai
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_AZURE_OPENAI_API_KEY=some_key
RAG_AZURE_OPENAI_BASE_URL=https://solwr-ai-poc.cognitiveservices.azure.com
RAG_AZURE_OPENAI_API_VERSION=2024-12-01-preview

RAG_RELEVANCE_THRESHOLD=0.0
RAG_TOP_K=5
RAG_TOP_K_RERANKER=5

DEFAULT_RAG_TEMPLATE="### Task:
Respond to the user query using the provided context, incorporating inline citations in the format [id] **only when the <source> tag includes an explicit id attribute** (e.g., <source id=\"1\">).

### Guidelines:
- If you don't know the answer, clearly state that.
- If uncertain, ask the user for clarification.
- Respond in the same language as the user's query.
- If the context is unreadable or of poor quality, inform the user and provide the best possible answer.
- If the answer isn't present in the context but you possess the knowledge, explain this to the user and provide the answer using your own understanding.
- **Only include inline citations using [id] (e.g., [1], [2]) when the <source> tag includes an id attribute.**
- Do not cite if the <source> tag does not contain an id attribute.
- Do not use XML tags in your response.
- Ensure citations are concise and directly related to the information provided.

### Example of Citation:
If the user asks about a specific topic and the information is found in a source with a provided id attribute, the response should include the citation like in the following example:
* \"According to the study, the proposed method increases efficiency by 20% [1].\"

### Output:
Provide a clear and direct response to the user's query, including inline citations in the format [id] only when the <source> tag with id attribute is present in the context.

<context>
{{CONTEXT}}
</context>

<user_query>
{{QUERY}}
</user_query>"

# JIRA Integration
JIRA_DOMAIN=driwno.atlassian.net
JIRA_CLOUD_ID=fdb2f5d2-f08d-4fa1-9916-5593a99e37b3 # Found using https://driwno.atlassian.net/_edge/tenant_info
JIRA_API_BASE_URL=https://driwno.atlassian.net/rest/api/3
JIRA_PROJECT_KEY=something
JIRA_OAUTH_PROVIDER=something
JIRA_SERVICE_ACCOUNT_EMAIL=service-account@example.com
JIRA_SERVICE_ACCOUNT_API_TOKEN=your_api_token

# Database
DATABASE_URL=postgresql://USERNAME:PASSWORD@john-pork.postgres.database.azure.com:5432/trace_ai

# Vector Database
VECTOR_DB=pgvector
PGVECTOR_DB_URL=postgresql://USERNAME:PASSWORD@john-pork.postgres.database.azure.com:5432/trace_ai
PGVECTOR_CREATE_EXTENSION=true
PGVECTOR_PGCRYPTO=True
PGVECTOR_PGCRYPTO_KEY=some_key

# Redis
# REDIS_URL=redis://redis-host:6379/0
# WEBSOCKET_MANAGER=redis
# ENABLE_WEBSOCKET_SUPPORT=true

# Storage — pick ONE:
# Option A: shared filesystem (no env vars needed, just mount the same volume)
# Option B: cloud storage
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=my-openwebui-bucket
# S3_REGION_NAME=us-east-1

# Testing
TEST_TICKET_KEY=TT-1  # A known Jira ticket key used by deterministic smoke tests

# MCP Server
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Workers (let orchestrator scale, keep workers at 1)
UVICORN_WORKERS=1

# Migrations (set to false on all but one instance)
ENABLE_DB_MIGRATIONS=false

# ===============================
# Microsoft Entra ID Configuration
# ===============================
MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET
MICROSOFT_CLIENT_TENANT_ID=YOUR_MICROSOFT_TENANT_ID
OPENID_PROVIDER_URL=https://login.microsoftonline.com/YOUR_MICROSOFT_TENANT_ID/v2.0/.well-known/openid-configuration

ENABLE_OATH_SIGNUP=true
MICROSOFT_OAUTH_SCOPE=openid profile email

# ===============================
# Atlassian OAuth Configuration
# ===============================
ATLASSIAN_CLIENT_ID=YOUR_ATLASSIAN_CLIENT_ID
ATLASSIAN_CLIENT_SECRET=YOUR_ATLASSIAN_CLIENT_SECRET
ATLASSIAN_REDIRECT_URI=http://localhost:8080/oauth/atlassian/callback
ATLASSIAN_OAUTH_SCOPE=read:me,read:account,read:jira-work,read:jira-user,write:jira-work

