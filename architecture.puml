@startuml
title Open WebUI - Jira Support Architecture

skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
left to right direction

actor "Support Agent" as user

node "User Device" {
  component "Web Browser\n(Svelte UI)" as ui
}

cloud "Open WebUI Runtime" {
  component "FastAPI Backend\nopen_webui.main" as api
  component "Jira Router\n/api/v1/jira" as jira_router
  component "OAuth Session Service\nOAuthSessions" as oauth_service
  component "Embedding Service\ngenerate_embeddings" as embed_service
  component "Jira Sync Worker\n(sync/create/status/meta)" as jira_service
}

database "App Database\n(SQLite or PostgreSQL)" as app_db
database "Vector Database\n(PGVector/Chroma/etc.)" as vector_db
folder "File Storage\nbackend/data/uploads" as file_store
queue "Redis (optional)\nscaling/session bus" as redis

cloud "Atlassian Cloud" {
  component "OAuth Token Endpoint\nauth.atlassian.com" as atlassian_oauth
  component "Jira REST API\napi.atlassian.com" as jira_api
}

cloud "LLM Provider" {
  component "Ollama / OpenAI-compatible API" as llm_api
}

user --> ui : HTTPS
ui --> api : REST/WebSocket
api --> jira_router : route /api/v1/jira/*

jira_router --> oauth_service : get/refresh OAuth session
oauth_service --> app_db : read/write oauth_session

jira_router --> jira_service : create/sync/status/meta
jira_service --> jira_api : Jira REST calls
jira_service --> atlassian_oauth : refresh_token
jira_service --> embed_service : embedding requests
embed_service --> llm_api : /embeddings or /chat

jira_service --> vector_db : upsert/search vectors
jira_service --> file_store : attachment read

api --> app_db : application data
api --> vector_db : RAG retrieval
api --> file_store : uploads/downloads
api --> redis : optional cache/session

note right of jira_service
  Jira integration flow:
  1) User connects Atlassian OAuth
  2) Create issue (+ optional attachments)
  3) Sync Jira tickets to vector index
  4) Use indexed tickets for support context
end note

@enduml
